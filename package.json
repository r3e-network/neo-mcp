{
  "name": "@r3e/neo-mcp",
  "version": "4.2.0",
  "description": "MCP server and HTTP API for Neo N3 and Neo X blockchain integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run test:unit",
    "test:unit": "jest --testMatch='**/tests/**/*.test.ts' --testPathIgnorePatterns='tests/mcp-'",
    "test:mcp": "jest --runInBand tests/mcp-build-smoke.test.ts --testPathIgnorePatterns='/node_modules/' && jest --runInBand tests/mcp-lifecycle.test.ts --testPathIgnorePatterns='/node_modules/' && jest --runInBand tests/mcp-tool-registration.test.ts --testPathIgnorePatterns='/node_modules/' && jest --runInBand tests/mcp-http-transport.test.ts --testPathIgnorePatterns='/node_modules/'",
    "test:mcp:live": "jest --runInBand tests/mcp-comprehensive.test.ts tests/mcp-latest-features.test.ts tests/mcp-protocol-compliance.test.ts --testPathIgnorePatterns='/node_modules/'",
    "test:mcp:stress": "jest --runInBand tests/mcp-stress.test.ts --testPathIgnorePatterns='/node_modules/'",
    "test:integration": "node tests/mcp-integration-test.js",
    "test:all": "npm run test:unit && npm run build && npm run test:mcp",
    "test:coverage": "jest --coverage --testPathIgnorePatterns='tests/mcp-'",
    "lint": "npm run type-check",
    "lint:fix": "npm run lint",
    "type-check": "tsc --noEmit",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "version:check": "node -p \"'Current version: ' + require('./package.json').version\"",
    "verify": "npm run type-check && npm run test:unit -- --runInBand && npm run build && npm run test:mcp",
    "release:prepare": "./scripts/prepare-release.sh",
    "prepack": "npm run build",
    "docker:build": "./scripts/docker-build.sh",
    "docker:build:dev": "./scripts/docker-build.sh --dev --tag dev",
    "docker:run": "./scripts/docker-run.sh",
    "docker:run:dev": "./scripts/docker-run.sh --image neo-mcp:dev --network testnet",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:up:dev": "docker compose -f docker/docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:test": "docker compose -f docker/docker-compose.dev.yml run --rm neo-mcp-test",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start:http": "node dist/http.js",
    "dev:http": "ts-node src/http.ts",
    "start:mcp-http": "node dist/mcp-http.js",
    "dev:mcp-http": "ts-node src/mcp-http.ts",
    "test:mcp:smoke": "jest --runInBand tests/mcp-build-smoke.test.ts --testPathIgnorePatterns='/node_modules/'"
  },
  "bin": {
    "neo-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "neo",
    "blockchain",
    "mcp",
    "n3",
    "neox",
    "evm",
    "modelcontextprotocol",
    "http",
    "api",
    "rest"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r3e-network/neo-mcp.git"
  },
  "homepage": "https://github.com/r3e-network/neo-mcp#readme",
  "bugs": {
    "url": "https://github.com/r3e-network/neo-mcp/issues"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "brace-expansion": "file:./tools/brace-expansion-cjs",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@cityofzion/neon-js": "^5.9.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "overrides": {
    "@cityofzion/neon-core": {
      "lodash": "4.18.1"
    },
    "@hono/node-server": "^2.0.5",
    "brace-expansion": "$brace-expansion"
  },
  "publishConfig": {
    "access": "public"
  }
}
